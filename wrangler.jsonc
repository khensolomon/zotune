// Cloudflare deployment of the build in dist/web (npm run build), made by
// .github/workflows/release.yml. Addresses that are not files (such as
// /definition/itna) get index.html, and the router in the app shows the page.
{
  "name": "zotune",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application"
  }
}
